# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OmniHub Daemon WebSocket configuration
# The local daemon runs on port 9123 on the host machine.
VITE_DAEMON_WS_URL="ws://localhost:9123"

# WebRTC STUN/TURN Signaling for Zero-Cloud P2P Sync
VITE_DEFAULT_STUN_SERVER="stun:stun.l.google.com:19302"

# Smart TV default discovery port
VITE_SMART_TV_PORT="8001"
